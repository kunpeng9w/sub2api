# Use a generated, identical 32+ character token in worker.env and gateway.env.
NETWORK_STATUS_TOKEN=REPLACE_WITH_RANDOM_SERVICE_TOKEN
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sub2api
PGUSER=sub2api_network_reader
PGPASSWORD=REPLACE_WITH_READER_PASSWORD
# Remote PostgreSQL connections should use PGSSLMODE=verify-full and PGSSLROOTCERT.
