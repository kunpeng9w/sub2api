# Sanitized live configuration; substitute secrets privately before installation.
server:
  host: 127.0.0.1
  port: 8080
  mode: release
  max_request_body_size: 16777216
database:
  host: 127.0.0.1
  port: 5432
  user: sub2api
  password: ${DATABASE_PASSWORD}
  dbname: sub2api
  sslmode: disable
  max_open_conns: 10
  max_idle_conns: 2
redis:
  host: 127.0.0.1
  port: 6379
  username: ''
  password: ${REDIS_PASSWORD}
  db: 0
  enable_tls: false
  pool_size: 16
  min_idle_conns: 2
jwt:
  secret: ${JWT_SECRET}
  expire_hour: 24
default:
  user_concurrency: 1
  user_balance: 0
  api_key_prefix: sk-
  rate_multiplier: 1
timezone: Asia/Shanghai
run_mode: simple
totp:
  encryption_key: ${TOTP_ENCRYPTION_KEY}
gateway:
  # Opt-in only after the independent network migration; application upgrades keep this off.
  claude_egress:
    enabled: false
    proxy_url: "http://127.0.0.1:7890"
  max_body_size: 16777216
  max_idle_conns: 16
  max_idle_conns_per_host: 4
  max_conns_per_host: 16
  text_max_body_size: 16777216
log:
  output_to_file: false
  output_to_stdout: true
