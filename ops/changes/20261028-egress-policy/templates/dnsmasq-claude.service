[Unit]
Description=Independent system DNS with official Claude domain forwarding
Wants=network-online.target
After=network-online.target
Before=sub2api.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/dnsmasq-claude.conf --pid-file=
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
